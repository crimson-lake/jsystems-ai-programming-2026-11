# Copy to .env (gitignored) and fill in. Never commit real keys. See docs/ADR/000-main-architecture.md section 7.

# Required
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna

# Optional (empty or commented values use the defaults shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_VISION_MODEL=openai/gpt-6-luna   (empty values would override the LLM_MODEL fallback, so leave unset)
# LLM_DECISION_MODEL=openai/gpt-6-luna
LLM_DECISION_REASONING_EFFORT=medium
OPENROUTER_APP_TITLE=Hardware Service Decision Copilot PoC
OPENROUTER_APP_URL=http://localhost:8080
LLM_TRIAGE_MODEL=openai/gpt-6-luna-decisions
# off | assist | fast-path (fast-path is not enabled in the PoC)
TRIAGE_MODE=off
TRIAGE_LOW_CONFIDENCE=0.80
TRIAGE_HIGH_CONFIDENCE=0.95
TRIAGE_SAFETY_PROBABILITY=0.30
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
SERVER_PORT=8080
CASE_TTL_MINUTES=60
APP_ZONE=Europe/Warsaw
