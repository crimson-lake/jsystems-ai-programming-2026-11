.DS_Store
# Installed skills are not committed: only skills-lock.json is tracked, and
# `npx skills install` restores .agents/skills/ and the .claude/skills/ links from it.
# research-report is a project-authored skill and stays tracked in .agents/skills/.
.agents/skills/*
!.agents/skills/research-report/
.claude/skills/
__pycache__/
*.pyc
.playwright-cli
playwright-report/
test-results/
playwright/.cache/

# Local Codex history, credentials and runtime state; keep shared config and rules.
.codex/auth.json
.codex/sessions/
.codex/archived_sessions/
.codex/history.jsonl
.codex/session_index.jsonl
.codex/log/
.codex/logs/
.codex/tmp/
.codex/*.sqlite*

# Private agent briefs and Java build artifacts
.agent-briefs/
**/target/
*.class
/.idea
